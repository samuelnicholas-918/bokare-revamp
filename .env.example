# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/bokare?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Admin seed credentials (used by prisma db seed)
ADMIN_EMAIL="professor@bokare.in"
ADMIN_PASSWORD="change-this-password"

# Public site URL (sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://bokare-revamp.vercel.app"

# Vercel Blob (optional — enables PDF upload in admin on production)
BLOB_READ_WRITE_TOKEN=""
